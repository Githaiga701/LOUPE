    "@radix-ui/react-tooltip": "^1.2.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workflow": "^5.5.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
