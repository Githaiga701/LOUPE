# --- Neon Postgres (Vercel marketplace → "Connect" to this project, or paste the URL) ---
DATABASE_URL=postgresql://user:pass@host/loupe?sslmode=require

# --- Vercel Blob (created automatically when you add a Blob store to the project) ---
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Python checks service ---
CHECKS_URL=http://localhost:8100
CHECKS_SHARED_SECRET=change-me
# "fake" streams synthetic signals so the UI can be built without the service
CHECKS_MODE=live

# --- Retention / cron ---
RETENTION_HOURS_ANON=24
CRON_SECRET=change-me

# --- Client ---
NEXT_PUBLIC_UPLOAD_MAX_MB=50
